generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================================================
// Better Auth models
// Managed to match Better Auth's core schema (user, session, account,
// verification). Regenerate with: bunx @better-auth/cli generate
// ==========================================================================

model User {
  id            String    @id @map("_id")
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ==========================================================================
// CV Builder models
// `userId` references `user._id` (a String id managed by Better Auth), so no
// formal Prisma relation is declared to avoid coupling with the auth schema.
// CV sections are embedded documents (MongoDB composite types).
// ==========================================================================

model CV {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  userId        String
  title         String          @default("Untitled CV")
  templateId    String          @default("classic")
  typography    Typography?
  colors        Colors?
  personal      Personal?
  summary       String?
  experience    Experience[]
  education      Education[]
  skills        Skill[]
  interpersonal Interpersonal[]
  languages     Language[]
  certifications Certification[]
  organizations Organization[]
  projects      Project[]
  custom        Custom[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@map("cv")
}

type Typography {
  fontHeading   String
  fontBody      String
  scale         Float
  lineHeight    Float
  letterSpacing Float
}

type Colors {
  presetId   String
  background String
  heading    String
  text       String
  link       String
  accent     String
}

type Personal {
  fullName String?
  headline String?
  email    String?
  phone    String?
  location String?
  website  String?
  linkedin String?
  github   String?
  photo    String?
}

type Experience {
  company     String
  role        String
  location    String?
  startDate   String?
  endDate     String?
  current     Boolean @default(false)
  description String?
}

type Education {
  school    String
  degree    String?
  field     String?
  startDate String?
  endDate   String?
  gpa       String?
}

type Skill {
  name  String
  level Int?
}

type Interpersonal {
  name String
}

type Language {
  name  String
  level String?
}

type Certification {
  name        String
  issuer      String?
  date        String?
  url         String?
  description String?
}

type Organization {
  name        String
  role        String?
  date        String?
  description String?
}

type Project {
  name        String
  type        String?
  date        String?
  skill       String?
  description String?
}

type Custom {
  title       String
  description String?
}
